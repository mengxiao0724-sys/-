<Window x:Class="引脚检测.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:halcon="http://schemas.mvtec.com/halcondotnet"
        xmlns:local="clr-namespace:引脚检测"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1400">
    <DockPanel>
        <!-- 顶部菜单工具栏 -->
        <StackPanel DockPanel.Dock="Top">
           
            <ToolBar>
                <Button Content="加载图像"   Command="{Binding LoadImageCommand}"    Margin="2,0"/>
                <Button Content="训练模板"   Command="{Binding TrainTemplateCommand}" Margin="2,0"/>
                <Button Content="单次检测"   Command="{Binding SingleDetectCommand}"  Margin="2,0"/>
                <Button Content="连续检测"   Command="{Binding ContinuousDetectCommand}" Margin="2,0"/>
                <Button Content="停止"       Command="{Binding StopCommand}"           Margin="2,0"/>
                <Separator/>
                <Button Content="历史查询"    Command="{Binding OpenHistoryCommand}"     Margin="2,0"/>
            </ToolBar>
        </StackPanel>

        <!-- 右侧参数面板 -->
        <Grid DockPanel.Dock="Right" Width="320">
            <ScrollViewer>
                <StackPanel Margin="5">
                    <Expander Header="模板配置" IsExpanded="True">
                        <StackPanel Margin="3">
                            <TextBlock Text="模板保存路径"/>
                            <TextBox Text="{Binding TemplatePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="浏览..." Margin="0,3"
                                    Command="{Binding BrowseTemplatePathCommand}"/>
                            <TextBlock Text="匹配最小分数"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding MinMatchScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding MinMatchScore, StringFormat=当前:0.00}" Margin="0,0,0,6"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="引脚测量参数" IsExpanded="True">
                        <StackPanel Margin="3">
                            <TextBlock Text="Sigma"/>
                            <Slider Minimum="0.5" Maximum="3" Value="{Binding Sigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding Sigma, StringFormat=当前:0.00}" Margin="0,0,0,6"/>

                            <TextBlock Text="边沿阈值"/>
                            <Slider Minimum="1" Maximum="30" Value="{Binding EdgeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding EdgeThreshold, StringFormat=当前:0.0}" Margin="0,0,0,6"/>

                            <TextBlock Text="引脚宽度最小(px)"/>
                            <TextBox Text="{Binding PinWidthMin, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="引脚宽度最大(px)"/>
                            <TextBox Text="{Binding PinWidthMax, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="检测结果" IsExpanded="True">
                        <StackPanel Margin="3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="状态："/>
                                <Label Content="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="匹配分数："/>
                                <Label Content="{Binding MatchScore, StringFormat={}{0:F3}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部日志 + 状态栏 -->
        <StackPanel DockPanel.Dock="Bottom">
            <TextBox Height="150" IsReadOnly="True"
                     Text="{Binding LogText, Mode=OneWay}"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"/>
            <StatusBar>
                <StatusBarItem Content="就绪"/>
                <StatusBarItem Content="{Binding ElapsedMs}"/>
            </StatusBar>
        </StackPanel>

        <!-- 中间 HALCON 显示窗口，自动填充剩余区域 -->
        <halcon:HSmartWindowControlWPF x:Name="HalconWindow" BorderThickness="0"/>
    </DockPanel>
</Window>
