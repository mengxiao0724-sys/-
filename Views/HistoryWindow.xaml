<Window x:Class="引脚检测.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:引脚检测.ViewModels"
        mc:Ignorable="d"
        Title="HistoryWindow" Height="450" Width="800">
    <DockPanel Margin="8">
        <!-- 查询条件 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="起始" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker SelectedDate="{Binding DateFrom}" Width="120"/>

            <TextBlock Text="结束" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <DatePicker SelectedDate="{Binding DateTo}" Width="120"/>

            <TextBlock Text="结果" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding FilterStatus}"
                      Width="80"/>

            <TextBlock Text="图片名" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="180"/>

            <Button Content="查询" Command="{Binding QueryCommand}" Margin="12,0,0,0" Padding="12,2"/>
            <Button Content="重置" Command="{Binding ClearCommand}" Margin="6,0,0,0" Padding="12,2"/>
        </StackPanel>

        <!-- 汇总 -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SummaryText}"
                   Margin="0,6,0,0" FontWeight="Bold"/>

        <!-- 结果表 -->
        <DataGrid ItemsSource="{Binding Records}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column"
                  RowBackground="White" AlternatingRowBackground="#F5F5F5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"              Binding="{Binding Id}"          Width="60"/>
                <DataGridTextColumn Header="时间"            Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                <DataGridTextColumn Header="图片名"          Binding="{Binding ImageName}"   Width="200"/>
                <DataGridTextColumn Header="结果"            Binding="{Binding IsOK}"         Width="60"/>
                <DataGridTextColumn Header="原因"            Binding="{Binding Reason}"       Width="*"/>
                <DataGridTextColumn Header="匹配分数"        Binding="{Binding MatchScore, StringFormat=F2}" Width="80"/>
                <DataGridTextColumn Header="引脚数"          Binding="{Binding PinCount}"    Width="60"/>
                <DataGridTextColumn Header="最小宽(px)"      Binding="{Binding MinPinWidth, StringFormat=F1}" Width="80"/>
                <DataGridTextColumn Header="最大宽(px)"      Binding="{Binding MaxPinWidth, StringFormat=F1}" Width="80"/>
                <DataGridTextColumn Header="耗时(ms)"        Binding="{Binding ElapsedMs}"    Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
